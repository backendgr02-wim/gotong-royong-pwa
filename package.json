{
  "name": "gotong-royong-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -p none 'serwist build --watch' 'next dev -p 6789'",
    "dev:once": "NODE_ENV=development serwist build && next dev -p 6789",
    "build": "next build && serwist build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "db:query": "supabase db query --linked --output table",
    "db:migrate": "supabase db execute --file",
    "db:pull": "supabase db pull --linked",
    "db:dump": "supabase db dump --linked -f"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "serwist": "^9.5.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.103.0"
  }
}
